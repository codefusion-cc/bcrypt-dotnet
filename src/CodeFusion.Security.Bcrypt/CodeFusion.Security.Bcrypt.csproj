<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- No net11.0: a .NET 11 app gets the net10.0 build, and the hot loop is compiled by whichever runtime runs it.
         The tests also run on .NET 11. -->
    <TargetFrameworks>$(BcryptFrameworks)</TargetFrameworks>
    <RootNamespace>CodeFusion.Security</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The generated loops are also written to obj/generated, to read and diff. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>

    <PackageId>CodeFusion.Security.Bcrypt</PackageId>
    <Version>1.0.1</Version>
    <Authors>Krystian Pawłow</Authors>
    <Company>CodeFusion</Company>
    <Copyright>Copyright (c) 2026 Krystian Pawłow</Copyright>
    <Description>Fast, allocation-free bcrypt for .NET: up to five hashes interleaved per thread, a batching queue for servers, and BCrypt.Net-Next compatible hashes.</Description>
    <PackageTags>bcrypt;password;hashing;security;blowfish;crypt</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/codefusion-cc/bcrypt-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/codefusion-cc/bcrypt-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- Writes the lane loops and the Blowfish tables (computed from pi) at compile time. Build-time only: the package
         doesn't depend on it. -->
    <ProjectReference Include="../CodeFusion.Security.Bcrypt.Generators/CodeFusion.Security.Bcrypt.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <InternalsVisibleTo Include="CodeFusion.Security.Bcrypt.Tests" />
    <InternalsVisibleTo Include="CodeFusion.Security.Bcrypt.Benchmarks" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
