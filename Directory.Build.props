<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- The same bytes from the same commit; CI sets ContinuousIntegrationBuild so paths are normalized too. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- The frameworks every project builds for. The tests and benchmarks also run on .NET 11 when the SDK is 11 or
         newer (the SDK's version isn't known yet here, so they add it themselves); CI always has it. -->
    <BcryptFrameworks>net8.0;net9.0;net10.0</BcryptFrameworks>
  </PropertyGroup>

</Project>
